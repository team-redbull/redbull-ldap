# Copy to .env and fill in. Every variable here is required - the service
# refuses to start without them rather than falling back to a default that
# points somewhere unexpected.

# Use ldaps:// - a plain ldap:// bind sends the password in cleartext.
LDAP_SERVER=ldaps://your-dc.example.internal
LDAP_DOMAIN=YOURDOMAIN

AD_API_URL=https://your-ad-api.example.internal/users/user/isUserMemberOfSecurityGroup
AD_API_CLIENT_ID=your-client-id

# --- optional, shown with their defaults ---
# LDAP_CONNECT_TIMEOUT=5
# LDAP_RECEIVE_TIMEOUT=10
# AD_API_TIMEOUT=10.0
# AD_API_RETRIES=2
# Only ever set this to false against a local test rig.
# AD_API_VERIFY_SSL=true
